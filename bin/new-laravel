#!/usr/bin/env bash
#
# new-laravel — Crea un proyecto Laravel nuevo con DDEV, listo para trabajar: base de
#   datos, Mailpit, MinIO (S3), SSL local, dominio https://<nombre>.ddev.site, Vite/HMR,
#   colas y scheduler corriendo solos, y Xdebug listo para VS Code y PhpStorm.
#
# Uso: new-laravel <nombre> [opciones]
#      new-laravel mi-tienda                      → PHP 8.5, Node 24, MySQL 8.4, esqueleto pelado
#      new-laravel mi-tienda --kit vue            → starter kit oficial: vue, react, livewire o none
#      new-laravel mi-tienda --db postgres        → motor: mysql, mariadb o postgres[:version]
#      new-laravel mi-tienda --php 8.4 --node 22
#      new-laravel mi-tienda 8.4 22 8.0           → forma corta: [php] [node] [version-mysql]
#      new-laravel --help
set -euo pipefail

# Puede estar enlazado desde ~/.local/bin: resolver el enlace para encontrar lib/
ORIGEN=$0
while [ -L "$ORIGEN" ]; do
  DIR=$(cd -- "$(dirname -- "$ORIGEN")" && pwd)
  ORIGEN=$(readlink "$ORIGEN")
  case $ORIGEN in /*) ;; *) ORIGEN="$DIR/$ORIGEN" ;; esac
done
RAIZ=$(cd -- "$(dirname -- "$ORIGEN")/.." && pwd)
# shellcheck source=../lib/comun.sh
. "$RAIZ/lib/comun.sh"
# shellcheck source=../lib/laravel.sh
. "$RAIZ/lib/laravel.sh"

PHP_VERSION=8.5
NODE_VERSION=24
DB=mysql:8.4
DB_OPCION=0
KIT=none
POSICIONALES=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      mostrar_ayuda "$0"
      exit 0
      ;;
    --kit)
      KIT=${2:?--kit necesita vue, react, livewire o none}
      shift
      ;;
    --db)
      DB=$(normalizar_db "${2:?--db necesita mysql, mariadb o postgres, con o sin versión}") ||
        fallo "--db: usa mysql, mariadb o postgres, con o sin versión (p. ej. postgres:18 o mariadb:11.8)"
      DB_OPCION=1
      shift
      ;;
    --php)
      PHP_VERSION=${2:?--php necesita una versión, p. ej. 8.4}
      shift
      ;;
    --node)
      NODE_VERSION=${2:?--node necesita una versión, p. ej. 22}
      shift
      ;;
    -*) fallo "Opción desconocida: $1 (mira new-laravel --help)" ;;
    *) POSICIONALES+=("$1") ;;
  esac
  shift
done
NOMBRE=${POSICIONALES[0]:-}
if [ -z "$NOMBRE" ]; then
  mostrar_ayuda "$0" >&2
  exit 1
fi
if [ -n "${POSICIONALES[1]:-}" ]; then PHP_VERSION=${POSICIONALES[1]}; fi
if [ -n "${POSICIONALES[2]:-}" ]; then NODE_VERSION=${POSICIONALES[2]}; fi
if [ -n "${POSICIONALES[3]:-}" ]; then
  if [ "$DB_OPCION" = 1 ]; then fallo "Di el motor con --db o con la forma corta [php] [node] [version-mysql], no con las dos"; fi
  DB="mysql:${POSICIONALES[3]}"
fi
case "$KIT" in
  none) PAQUETE=laravel/laravel ;;
  vue) PAQUETE=laravel/vue-starter-kit ;;
  react) PAQUETE=laravel/react-starter-kit ;;
  livewire) PAQUETE=laravel/livewire-starter-kit ;;
  *) fallo "--kit '$KIT' no existe: usa vue, react, livewire o none" ;;
esac

# --- chequeos previos: mejor fallar ahora que a medio camino -----------------
if ! nombre_valido "$NOMBRE"; then
  SUGERIDO=$(sugerir_nombre "$NOMBRE")
  fallo "'$NOMBRE' no sirve como nombre de proyecto: es el dominio https://<nombre>.ddev.site, así que solo letras, dígitos y guiones (p. ej. '${SUGERIDO:-mi-app}')."
fi
requiere ddev docker jq
docker_responde
if [ -e "$NOMBRE" ]; then
  fallo "La carpeta '$NOMBRE' ya existe aquí. Elige otro nombre o entra a esa carpeta."
fi

# si algo falla a medio camino, explica cómo dejar todo limpio (no borra nada solo)
CREADO=0
al_fallar() {
  echo
  printf "${ROJO}✖ new-laravel falló (línea %s).${SC}\n" "$1" >&2
  if [ "$CREADO" = 1 ]; then
    echo "  Para limpiar y volver a intentar:" >&2
    echo "    cd .. && ddev delete -Oy '$NOMBRE'; rm -rf '$NOMBRE'" >&2
  fi
}
trap 'al_fallar $LINENO' ERR

paso "Creando '$NOMBRE' (PHP $PHP_VERSION, Node $NODE_VERSION, $DB, kit: $KIT)"
if [ "$KIT" != none ] && [ "$PHP_VERSION" != "${PHP_VERSION#8.5}" ]; then
  aviso "los starter kits todavía se basan en Laravel 12 y con PHP 8.5 muestran avisos de deprecación de PDO; si te molestan, usa --php 8.4"
fi
mkdir -p "$NOMBRE"
CREADO=1
cd "$NOMBRE"

# --- DDEV: tipo laravel, versiones por proyecto, opiniones del kit y MinIO ---
ddev config --project-type=laravel --docroot=public \
  --php-version="$PHP_VERSION" --nodejs-version="$NODE_VERSION" \
  --database="$DB"
ddev_config_kit "$RAIZ"         # .ddev/config.kit.yaml: Vite, colas, scheduler, corepack
ddev add-on get ddev/ddev-minio # S3 local — https://github.com/ddev/ddev-minio
ddev start -y

# --- Laravel -----------------------------------------------------------------
# --no-interaction: sin él, DDEV o Composer pueden quedarse esperando una respuesta
# que nadie va a escribir (pasa con los starter kits)
ddev composer create-project --no-interaction "$PAQUETE"
ddev composer require --no-interaction league/flysystem-aws-s3-v3 "^3.0" --with-all-dependencies

# --- .env: BD y Mailpit de DDEV, MinIO, y la URL real que sabe DDEV -----------
URL_APP=$(ddev_url primary_url "https://${NOMBRE}.ddev.site")
URL_MAILPIT=$(ddev_url mailpit_https_url "https://${NOMBRE}.ddev.site:8026")
URL_BASE=$(url_sin_puerto "$URL_APP") # sin el puerto alternativo del router: MinIO usa los suyos
env_laravel_ddev "$URL_APP" "$DB"
env_minio "$NOMBRE" "$URL_BASE"

# --- Vite + HMR a través de DDEV ---------------------------------------------
configurar_vite

# --- Bucket, dependencias front y migraciones -------------------------------
ddev mc mb --ignore-existing "minio/${NOMBRE}" || true
ddev npm install
ddev artisan migrate --no-interaction
rm -f database/database.sqlite # el esqueleto migró contra un sqlite temporal antes de apuntar a la BD real
ddev restart -y >/dev/null     # con vendor/ y .env listos arrancan bien colas y scheduler

# --- Xdebug listo para VS Code ----------------------------------------------
mkdir -p .vscode
cp "$RAIZ/templates/vscode-launch.json" .vscode/launch.json

# --- Git ---------------------------------------------------------------------
git init -q -b main
git add -A
git commit -qm "Proyecto Laravel nuevo con DDEV (PHP ${PHP_VERSION}, ${DB}, MinIO, Mailpit, Vite)" ||
  echo "   (commit inicial omitido: configura tu identidad git)"

cat <<FIN

✔ Proyecto '$NOMBRE' listo.

   App:            ${URL_APP}     (o: ddev launch)
   Mailpit:        ${URL_MAILPIT}     (o: ddev launch -m)
   MinIO consola:  ${URL_BASE}:9090     (ddevminio / ddevminio)
   Base de datos:  ddev mysql   (host 'db', bd/usuario/clave: db)$(case "$DB" in postgres*) printf ' → aquí: ddev psql' ;; esac)
   Colas y scheduler: ya corren dentro del contenedor (.ddev/config.kit.yaml); logs: ddev logs -f

   Día a día (dentro de la carpeta):
     ddev artisan ...     ddev composer ...    ddev npm run dev
     ddev xdebug on|off   ddev describe        ddev ssh
FIN
