#!/usr/bin/env bash
#
# new-laravel — Crea un proyecto Laravel nuevo con DDEV, listo para trabajar:
#   MySQL, Mailpit, MinIO (S3), SSL local, dominio https://<nombre>.ddev.site,
#   Vite/HMR configurado y Xdebug listo para VS Code y PhpStorm.
#
# Uso: new-laravel <nombre> [version-php] [version-node] [version-mysql]
#      new-laravel mi-tienda              → PHP 8.4, Node 22, MySQL 8.0
#      new-laravel mi-tienda 8.3 20 8.0
set -euo pipefail

RAIZ=$(cd -- "$(dirname -- "$0")/.." && pwd)
NOMBRE=${1:?Uso: new-laravel <nombre> [version-php] [version-node] [version-mysql]}
PHP_VERSION=${2:-8.4}
NODE_VERSION=${3:-22}
MYSQL_VERSION=${4:-8.0}

if [ -e "$NOMBRE" ]; then
  echo "La carpeta '$NOMBRE' ya existe aquí. Elige otro nombre o entra a esa carpeta."
  exit 1
fi

echo "==> Creando '$NOMBRE' (PHP $PHP_VERSION, Node $NODE_VERSION, MySQL $MYSQL_VERSION)"
mkdir -p "$NOMBRE"
cd "$NOMBRE"

# --- DDEV: tipo laravel + versiones por proyecto -----------------------------
ddev config --project-type=laravel --docroot=public \
  --php-version="$PHP_VERSION" --nodejs-version="$NODE_VERSION" \
  --database="mysql:${MYSQL_VERSION}"

# Vite dev server (receta oficial: https://docs.ddev.com/en/stable/users/usage/vite/)
cat >> .ddev/config.yaml <<'YAML'

web_extra_exposed_ports:
  - name: vite
    container_port: 5173
    http_port: 5172
    https_port: 5173
YAML

# MinIO (S3 local) — https://github.com/ddev/ddev-minio
ddev add-on get ddev/ddev-minio

ddev start -y

# --- Laravel -----------------------------------------------------------------
ddev composer create-project laravel/laravel
ddev composer require league/flysystem-aws-s3-v3 "^3.0" --with-all-dependencies

# --- .env --------------------------------------------------------------------
env_set() {
  local clave=$1 valor=$2
  if grep -qE "^#?[[:space:]]*${clave}=" .env; then
    # sin sed -i: su sintaxis difiere entre GNU (Linux) y BSD (macOS)
    sed -E "s|^#?[[:space:]]*${clave}=.*|${clave}=${valor}|" .env > .env.tmp && mv .env.tmp .env
  else
    printf '%s=%s\n' "$clave" "$valor" >> .env
  fi
}

# la URL real la sabe DDEV: si 80/443 están ocupados (p. ej. Laravel Valet),
# el router cae a puertos alternativos y la URL lleva puerto
URL_APP=$(ddev describe -j 2>/dev/null | jq -r '.raw.primary_url // empty')
if [ -z "$URL_APP" ]; then URL_APP="https://${NOMBRE}.ddev.site"; fi
URL_MAILPIT=$(ddev describe -j 2>/dev/null | jq -r '.raw.mailpit_https_url // empty')
if [ -z "$URL_MAILPIT" ]; then URL_MAILPIT="https://${NOMBRE}.ddev.site:8026"; fi

env_set APP_URL "$URL_APP"
# Base de datos → contenedor 'db' de DDEV
env_set DB_CONNECTION mysql
env_set DB_HOST db
env_set DB_PORT 3306
env_set DB_DATABASE db
env_set DB_USERNAME db
env_set DB_PASSWORD db
# Correo → Mailpit (interfaz: https://<nombre>.ddev.site:8026)
env_set MAIL_MAILER smtp
env_set MAIL_HOST 127.0.0.1
env_set MAIL_PORT 1025
# Archivos → MinIO (S3 local; consola: ddev minio)
env_set AWS_ACCESS_KEY_ID ddevminio
env_set AWS_SECRET_ACCESS_KEY ddevminio
env_set AWS_DEFAULT_REGION us-east-1
env_set AWS_BUCKET "$NOMBRE"
env_set AWS_ENDPOINT "http://minio:10101"
env_set AWS_USE_PATH_STYLE_ENDPOINT true
env_set AWS_URL "https://${NOMBRE}.ddev.site:10101/${NOMBRE}"

# --- Vite + HMR dentro de DDEV ----------------------------------------------
if [ -f vite.config.js ] && ! grep -q "DDEV_PRIMARY_URL_WITHOUT_PORT" vite.config.js; then
  awk '
    { print }
    /defineConfig\(\{/ && !hecho {
      print "    server: {"
      print "        host: \"0.0.0.0\","
      print "        port: 5173,"
      print "        strictPort: true,"
      print "        origin: `${process.env.DDEV_PRIMARY_URL_WITHOUT_PORT}:5173`,"
      print "        cors: {"
      print "            origin: /https?:\\/\\/([A-Za-z0-9\\-\\.]+)?(\\.ddev\\.site)(?::\\d+)?$/,"
      print "        },"
      print "    },"
      hecho=1
    }
  ' vite.config.js > vite.config.js.nuevo && mv vite.config.js.nuevo vite.config.js
fi

# --- Bucket, dependencias front y migraciones -------------------------------
ddev mc mb --ignore-existing "minio/${NOMBRE}" || true
ddev npm install
ddev artisan migrate --no-interaction

# --- Xdebug listo para VS Code ----------------------------------------------
mkdir -p .vscode
cp "$RAIZ/templates/vscode-launch.json" .vscode/launch.json

# --- Git ---------------------------------------------------------------------
git init -q -b main
git add -A
git commit -qm "Proyecto Laravel nuevo con DDEV (PHP ${PHP_VERSION}, MySQL ${MYSQL_VERSION}, MinIO, Mailpit, Vite)" \
  || echo "   (commit inicial omitido: configura tu identidad git)"

cat <<FIN

✔ Proyecto '$NOMBRE' listo.

   App:            ${URL_APP}
   Mailpit:        ${URL_MAILPIT}     (o: ddev launch -m)
   MinIO consola:  https://${NOMBRE}.ddev.site:9090     (ddevminio / ddevminio)
   MySQL:          ddev mysql   (host 'db', bd/usuario/clave: db)

   Día a día (dentro de la carpeta):
     ddev artisan ...     ddev composer ...    ddev npm run dev
     ddev xdebug on|off   ddev describe        ddev ssh
FIN
