#!/usr/bin/env bash
#
# adopt-laravel — Configura DDEV en un proyecto Laravel EXISTENTE (recién clonado).
#
# Uso (DENTRO de la carpeta del proyecto):
#   cd mi-proyecto && adopt-laravel [opciones]
#   adopt-laravel --db postgres            → motor: mysql, mariadb o postgres[:version]
#                                            (sin --db lo deduce del DB_CONNECTION del .env)
#   adopt-laravel --php 8.4 --node 22
#   adopt-laravel 8.4 22 8.0               → forma corta: [php] [node] [version-mysql]
#   adopt-laravel --help
#
# Si el proyecto ya trae .ddev/ versionado, lo respeta y solo levanta el entorno.
set -euo pipefail

# Puede estar enlazado desde ~/.local/bin: resolver el enlace para encontrar lib/
ORIGEN=$0
while [ -L "$ORIGEN" ]; do
  DIR=$(cd -- "$(dirname -- "$ORIGEN")" && pwd)
  ORIGEN=$(readlink "$ORIGEN")
  case $ORIGEN in /*) ;; *) ORIGEN="$DIR/$ORIGEN" ;; esac
done
RAIZ=$(cd -- "$(dirname -- "$ORIGEN")/.." && pwd)
# shellcheck source=../lib/comun.sh
. "$RAIZ/lib/comun.sh"
# shellcheck source=../lib/laravel.sh
. "$RAIZ/lib/laravel.sh"

PHP_VERSION=8.5
NODE_VERSION=24
DB=""
DB_OPCION=0
POSICIONALES=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      mostrar_ayuda "$0"
      exit 0
      ;;
    --db)
      DB=$(normalizar_db "${2:?--db necesita mysql, mariadb o postgres, con o sin versión}") ||
        fallo "--db: usa mysql, mariadb o postgres, con o sin versión (p. ej. postgres:18 o mariadb:11.8)"
      DB_OPCION=1
      shift
      ;;
    --php)
      PHP_VERSION=${2:?--php necesita una versión, p. ej. 8.4}
      shift
      ;;
    --node)
      NODE_VERSION=${2:?--node necesita una versión, p. ej. 22}
      shift
      ;;
    -*) fallo "Opción desconocida: $1 (mira adopt-laravel --help)" ;;
    *) POSICIONALES+=("$1") ;;
  esac
  shift
done
if [ -n "${POSICIONALES[0]:-}" ]; then PHP_VERSION=${POSICIONALES[0]}; fi
if [ -n "${POSICIONALES[1]:-}" ]; then NODE_VERSION=${POSICIONALES[1]}; fi
if [ -n "${POSICIONALES[2]:-}" ]; then
  if [ "$DB_OPCION" = 1 ]; then fallo "Di el motor con --db o con la forma corta [php] [node] [version-mysql], no con las dos"; fi
  DB="mysql:${POSICIONALES[2]}"
fi

if [ ! -f artisan ]; then
  fallo "Aquí no hay un proyecto Laravel (no encuentro 'artisan')."
fi
requiere ddev docker jq
docker_responde
NOMBRE=$(basename "$PWD")
if [ ! -f .ddev/config.yaml ] && ! nombre_valido "$NOMBRE"; then
  fallo "La carpeta se llama '$NOMBRE' y DDEV la usaría como dominio (https://<nombre>.ddev.site): renómbrala con letras, dígitos y guiones, p. ej. '$(sugerir_nombre "$NOMBRE")'."
fi

CREADO_DDEV=0
if [ ! -f .ddev/config.yaml ]; then
  # sin --db, el motor sale del DB_CONNECTION que ya usa el proyecto
  if [ -z "$DB" ]; then
    # cat tolera que falte .env o .env.example; el || true evita que pipefail aborte por eso
    DRIVER=$(cat .env .env.example 2>/dev/null | grep -E '^DB_CONNECTION=' | head -1 | cut -d= -f2 | tr -d '"\r' || true)
    case "$DRIVER" in
      pgsql) DB=postgres:18 ;;
      mariadb) DB=mariadb:11.8 ;;
      *) DB=mysql:8.4 ;;
    esac
    if [ -n "$DRIVER" ]; then echo "    (DB_CONNECTION=$DRIVER en el .env → motor $DB; cámbialo con --db)"; fi
  fi
  paso "Configurando DDEV (PHP $PHP_VERSION, Node $NODE_VERSION, $DB)"
  ddev config --project-type=laravel --docroot=public \
    --php-version="$PHP_VERSION" --nodejs-version="$NODE_VERSION" \
    --database="$DB"
  ddev_config_kit "$RAIZ" # .ddev/config.kit.yaml: Vite, colas, scheduler, corepack
  ddev add-on get ddev/ddev-minio
  CREADO_DDEV=1
else
  paso "Este proyecto ya trae .ddev/ versionado; lo uso tal cual"
  if [ -z "$DB" ]; then DB=$(ddev_db_configurada); fi
fi

ddev start -y

if [ ! -f .env ] && [ -f .env.example ]; then
  cp .env.example .env
fi
URL_APP=$(ddev_url primary_url "https://${NOMBRE}.ddev.site")
env_laravel_ddev "$URL_APP" "${DB:-mysql}"
# MinIO solo si el add-on está presente en este proyecto
if [ -f .ddev/docker-compose.minio.yaml ]; then
  env_minio "$NOMBRE" "$(url_sin_puerto "$URL_APP")"
  ddev mc mb --ignore-existing "minio/${NOMBRE}" || true
fi
# Vite para DDEV solo cuando este comando creó el .ddev/: si el equipo ya lo tenía
# configurado, su vite.config es cosa suya
if [ "$CREADO_DDEV" = 1 ]; then configurar_vite; fi

ddev composer install --no-interaction
if ! grep -qE '^APP_KEY=.+' .env; then
  ddev artisan key:generate
fi

mkdir -p .vscode
if [ ! -f .vscode/launch.json ]; then
  cp "$RAIZ/templates/vscode-launch.json" .vscode/launch.json
fi

cat <<FIN

✔ '$NOMBRE' adoptado en DDEV.

   App: ${URL_APP}

   Siguientes pasos según tu caso:
     ddev import-db --file=~/respaldos-ddev/<fecha>/${NOMBRE}.sql.gz   # restaurar BD
     ddev artisan migrate                                              # o migrar de cero
     ddev npm install && ddev npm run dev                              # frontend

   Consejo: versiona la carpeta .ddev/ en git para que el equipo (y tu yo
   post-formateo) levante el entorno solo con 'ddev start'.
FIN
